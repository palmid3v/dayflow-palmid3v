# Temporary local bridge
VITE_TODO_URL=http://localhost:5173
VITE_TODO_ORIGIN=http://localhost:5173

# Preview-only visual demo; set to true ONLY for a Vercel Preview deployment.
# This bypasses login for local-only demo data and must remain unset/false in Production.
VITE_DAYFLOW_DEMO_MODE=false

# Firebase Web SDK configuration — populated after the Firebase project is created
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
