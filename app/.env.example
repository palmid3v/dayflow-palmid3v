# Temporary local bridge
VITE_TODO_URL=http://localhost:5173
VITE_TODO_ORIGIN=http://localhost:5173

# Preview-only demo; use VITE_DAYFLOW_DEMO_MODE=true in Vercel Preview only.
# The app additionally requires VERCEL_ENV=preview, so Production will ignore the flag.
# LocalStorage is isolated and all writes remain in this browser; no Firestore access.
VITE_DAYFLOW_DEMO_MODE=false

# Firebase Web SDK configuration — populated after the Firebase project is created
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
