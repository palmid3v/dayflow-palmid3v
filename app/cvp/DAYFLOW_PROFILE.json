{
  "schemaVersion": 1,
  "framework": {
    "name": "PALMI-D3V Validation Framework",
    "version": 1,
    "profileTemplate": "validation/PROJECT_VALIDATION_PROFILE.template.json"
  },
  "project": {
    "id": "dayflow-palmid3v",
    "name": "DayFlow",
    "version": "0.2.0",
    "appPath": "app",
    "productionUrlEnv": "DAYFLOW_VALIDATE_URL",
    "defaultProductionUrl": "https://dayflow-palmid3v.vercel.app"
  },
  "stack": ["React", "Vite", "Tailwind CSS", "Firebase Authentication", "Cloud Firestore", "PWA"],
  "commands": {
    "install": {"command": "npm", "arguments": ["ci", "--ignore-scripts", "--no-audit", "--no-fund"]},
    "test": {"command": "npm", "arguments": ["test"]},
    "lint": {"command": "npm", "arguments": ["run", "lint"]},
    "build": {"command": "npm", "arguments": ["run", "build"]},
    "validateStatic": {"command": "npm", "arguments": ["run", "validate:static"]},
    "cvp": {"command": "npm", "arguments": ["run", "test:cvp"]},
    "e2e": {"command": "npm", "arguments": ["run", "test:e2e"]},
    "validate": {"command": "npm", "arguments": ["run", "validate"]}
  },
  "requiredPaths": {
    "files": [
      "app/package.json", "app/package-lock.json", "app/vite.config.js",
      "app/src/App.jsx", "app/src/lib/dayflowCloudStore.js", "app/src/lib/access.js",
      "app/playwright.config.mjs", "app/e2e/dayflow.spec.mjs", "app/e2e/cvp.spec.mjs",
      "app/e2e/fixtures/validation.ics", "firebase.json", "firestore.rules"
    ],
    "directories": [
      "app/src/features/tasks", "app/src/features/schedule", "app/src/features/calendar",
      "app/src/features/reminders", "app/src/features/memory", "app/src/features/dashboard", "app/tests"
    ]
  },
  "sourceChecks": [
    {"path": "firebase.json", "pattern": "\"rules\"\\s*:\\s*\"firestore.rules\"", "description": "Canonical Firestore rules source"},
    {"path": "firestore.rules", "pattern": "function canUseDayFlowFeature", "description": "Feature-aware Firestore permissions"},
    {"path": "app/vite.config.js", "pattern": "VitePWA", "description": "PWA plugin"}
  ],
  "validationLevels": {
    "required": ["V0", "V1", "V2", "V3", "V5", "V6"],
    "releaseRequired": ["V0", "V1", "V2", "V3", "V4", "V5", "V6", "V7", "V8"]
  },
  "criticalJourneys": [
    "Authentication and Today access",
    "Today block lifecycle",
    "Tasks lifecycle",
    "Dashboard visibility"
  ],
  "interactiveSmokeScenarios": [
    "Primary Play/start interaction",
    "Representative Today block interaction",
    "Representative Tasks CRUD interaction",
    "Representative Schedule CRUD interaction",
    "Calendar import and clear",
    "Reminder interaction",
    "Memory persistence",
    "Responsive mobile interaction",
    "PWA runtime interaction"
  ],
  "releaseGates": [
    "automated validation",
    "Firebase rules deployment confirmation",
    "production E2E",
    "Interactive Product Verification",
    "PWA and responsive verification",
    "rollback evidence"
  ]
}
